// Shared Slint widgets the dialogs are built from: buttons, boxed
// lists and their rows, entries, switches, the toggle pill, the spinner, the toast and the
// context menu.

import { Theme } from "theme.slint";

// 0 plain, 1 suggested, 2 destructive, 3 flat.
export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <int> kind: 0;
    in property <bool> circular: false;
    in property <length> button-height: 34px;
    callback clicked();

    min-width: root.text == "" ? root.button-height : 0px;
    height: root.button-height;
    border-radius: root.circular ? self.height / 2 : 6px;
    // Faded through its colours, not `opacity`: FemtoVG draws a translucent item with
    // children into a texture off the pixel grid, which blurs the label.
    property <float> fade: root.enabled ? 0 : 0.5;
    background: self.base.transparentize(self.fade);
    property <brush> base: root.kind == 1 ? (touch.pressed ? Theme.accent.darker(0.2) : touch.has-hover ? Theme.accent.brighter(0.1) : Theme.accent)
        : root.kind == 2 ? (touch.pressed ? Theme.error-bg.darker(0.2) : touch.has-hover ? Theme.error-bg.brighter(0.1) : Theme.error-bg)
        : root.kind == 3 ? (touch.pressed ? Theme.ink(0.16) : touch.has-hover ? Theme.ink(0.07) : transparent)
        : (touch.pressed ? Theme.ink(0.3) : touch.has-hover ? Theme.ink(0.15) : Theme.ink(0.1));
    property <color> ink: (root.kind == 1 || root.kind == 2 ? Theme.accent-fg : Theme.fg).transparentize(self.fade);

    HorizontalLayout {
        padding-left: root.text == "" ? 0px : 12px;
        padding-right: root.text == "" ? 0px : 12px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.ink;
                width: 16px;
                height: 16px;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.ink;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A three-quarter ring turning once a second.
export component Spinner inherits Rectangle {
    in property <length> size: 16px;
    width: root.size;
    height: root.size;

    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: "M 8 1.5 A 6.5 6.5 0 1 1 1.5 8";
        stroke: Theme.fg;
        stroke-width: 2px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: mod(animation-tick() / 1ms, 1000) / 1000 * 360deg;
    }
}

export component Switch inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 48px;
    height: 26px;
    border-radius: self.height / 2;
    property <float> fade: root.enabled ? 0 : 0.5;
    background: (root.checked ? Theme.accent : touch.has-hover && root.enabled ? Theme.ink(0.2) : Theme.ink(0.15)).transparentize(self.fade);
    animate background { duration: 150ms; }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: self.height / 2;
        background: #ffffff.transparentize(root.fade);
        drop-shadow-blur: 2px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000033;
        animate x { duration: 150ms; easing: ease-out; }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// Toggle group: a row of equal toggles on a sunken pill, one of them raised.
export component ToggleGroup inherits Rectangle {
    in property <[string]> labels;
    in property <int> active;
    in property <bool> enabled: true;
    callback chosen(int);

    height: 40px;
    border-radius: 9px;
    background: Theme.ink(0.1);
    property <float> fade: root.enabled ? 0 : 0.5;

    HorizontalLayout {
        padding: 3px;
        spacing: 3px;
        for label[index] in root.labels: Rectangle {
            horizontal-stretch: 1;
            border-radius: 6px;
            background: (index == root.active ? (Theme.dark ? #ffffff26 : #ffffff) : touch.has-hover ? Theme.ink(0.07) : transparent).transparentize(root.fade);
            drop-shadow-blur: index == root.active ? 3px : 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-color: #00000026;

            Text {
                text: label;
                color: Theme.fg.transparentize(root.fade);
                font-weight: 700;
                overflow: elide;
                horizontal-alignment: center;
                width: parent.width - 12px;
            }

            touch := TouchArea {
                enabled: root.enabled;
                clicked => {
                    if (index != root.active) {
                        root.chosen(index);
                    }
                }
            }
        }
    }
}

// A text entry on a faint fill.
export component Entry inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password: false;
    in property <image> icon;
    in property <bool> has-icon: false;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited(string);

    height: 34px;
    border-radius: 6px;
    background: Theme.ink(0.1);
    border-width: input.has-focus ? 2px : 0px;
    border-color: Theme.accent.with-alpha(0.5);

    public function focus-input() {
        input.focus();
    }

    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: Theme.ink(0.55);
                width: 16px;
                height: 16px;
            }
        }
        Rectangle {
            clip: true;
            if input.text == "": Text {
                x: 0;
                text: root.placeholder;
                color: Theme.ink(0.5);
                vertical-alignment: center;
                height: parent.height;
            }
            input := TextInput {
                color: Theme.fg;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.3);
                selection-foreground-color: Theme.fg;
                accepted => {
                    root.accepted();
                }
                edited => {
                    root.edited(self.text);
                }
            }
        }
    }
}

// Boxed list: rows on one rounded card.
export component BoxedList inherits Rectangle {
    background: Theme.card-bg;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.card-outline;
    drop-shadow-blur: 3px;
    drop-shadow-offset-y: 1px;
    drop-shadow-color: Theme.card-shadow;

    // No clip: FemtoVG draws a rounded clip's children into a texture it places off the
    // pixel grid, which blurs every line of text in it. The rows round their own hover.
    VerticalLayout {
        @children
    }
}

// The hairline between rows of a boxed list, drawn by every row after the first.
component Separator inherits Rectangle {
    y: 0;
    height: 1px;
    background: Theme.ink(0.1);
}

// Action row: a prefix mark, a title over a subtitle, and suffix widgets at the end.
// Strings are the daemon's words and are drawn as text, never markup.
export component ActionRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> mark;
    in property <bool> has-mark: false;
    in property <length> mark-size: 32px;
    in property <bool> first: true;
    // The bottom row of its list, whose hover follows the list's rounded corners.
    in property <bool> last: false;
    in property <bool> activatable: false;
    in property <bool> enabled: true;
    in property <length> indent: 0px;
    // The tree elbow an account row hangs from its provider by.
    in property <bool> elbow: false;
    // A subtitle with no spaces to break at, such as a path.
    in property <bool> wrap-anywhere: false;
    callback activated();

    min-height: 50px;
    background: root.activatable && root.enabled ? (touch.pressed ? Theme.ink(0.1) : touch.has-hover ? Theme.ink(0.04) : transparent) : transparent;
    border-top-left-radius: root.first ? 12px : 0px;
    border-top-right-radius: root.first ? 12px : 0px;
    border-bottom-left-radius: root.last ? 12px : 0px;
    border-bottom-right-radius: root.last ? 12px : 0px;

    if !root.first: Separator { }

    touch := TouchArea {
        enabled: root.activatable && root.enabled;
        clicked => {
            root.activated();
        }
    }

    HorizontalLayout {
        padding-left: 12px + root.indent;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;

        if root.elbow: Rectangle {
            width: 12px;
            Rectangle {
                x: 1px;
                y: parent.height / 2 - 13px;
                width: 2px;
                height: 14px;
                background: Theme.ink(0.7);
            }
            Rectangle {
                x: 1px;
                y: parent.height / 2 - 1px;
                width: 10px;
                height: 2px;
                background: Theme.ink(0.7);
            }
        }

        if root.has-mark: VerticalLayout {
            alignment: center;
            Image {
                source: root.mark;
                colorize: Theme.fg;
                width: root.mark-size;
                height: root.mark-size;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.fg.transparentize(root.enabled ? 0 : 0.5);
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.ink(Theme.dim).transparentize(root.enabled ? 0 : 0.5);
                font-size: Theme.footer;
                wrap: root.wrap-anywhere ? TextWrap.char-wrap : TextWrap.word-wrap;
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}

// Text and password rows: the title sits in the field until there is text or
// focus, then shrinks above it.
export component EntryRow inherits Rectangle {
    in property <string> title;
    in property <bool> password: false;
    in property <bool> number: false;
    in property <bool> first: true;
    in property <bool> enabled: true;
    // Error state: the field says it is the one that is wrong.
    in property <bool> error: false;
    in-out property <string> text <=> input.text;
    callback accepted();

    public function focus-input() {
        input.focus();
    }

    property <bool> raised: input.has-focus || input.text != "";
    property <float> fade: root.enabled ? 0 : 0.5;
    min-height: 54px;

    if !root.first: Separator { }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;

        Rectangle {
            horizontal-stretch: 1;
            clip: true;
            Text {
                x: 0;
                y: root.raised ? 7px : (parent.height - self.height) / 2;
                text: root.title;
                color: (root.error ? Theme.error : root.raised && input.has-focus ? Theme.accent : Theme.ink(Theme.dim)).transparentize(root.fade);
                font-size: root.raised ? Theme.caption : Theme.body;
                animate y, font-size { duration: 120ms; easing: ease-out; }
            }
            input := TextInput {
                x: 0;
                y: 24px;
                width: parent.width;
                height: parent.height - 30px;
                // Hidden while the title sits in it, by colour: `opacity` would be a layer.
                color: (root.error ? Theme.error : Theme.fg).transparentize(root.raised ? root.fade : 1);
                enabled: root.enabled;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : root.number ? InputType.number : InputType.text;
                selection-background-color: Theme.accent.with-alpha(0.3);
                selection-foreground-color: Theme.fg;
                accepted => {
                    root.accepted();
                }
            }
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}

// Combo row: the title, the chosen value, and a menu of the choices.
export component ComboRow inherits Rectangle {
    in property <string> title;
    // Shown under the title when the choice is not, or when there is no choice to show.
    in property <string> subtitle;
    in property <[string]> choices;
    // -1: a value this build does not know, which is shown rather than guessed at.
    in property <int> selected;
    // Subtitle mode: the choice under the title rather than at the end.
    in property <bool> value-as-subtitle: false;
    in property <bool> enabled: true;
    in property <bool> first: true;
    in property <bool> last: false;
    callback chosen(int);

    property <bool> known: root.selected >= 0 && root.selected < root.choices.length;
    property <float> fade: root.enabled ? 0 : 0.5;
    property <string> under: root.value-as-subtitle && root.known ? root.choices[root.selected] : root.subtitle;
    min-height: 50px;
    background: !root.enabled ? transparent : touch.pressed ? Theme.ink(0.1) : touch.has-hover ? Theme.ink(0.04) : transparent;
    border-top-left-radius: root.first ? 12px : 0px;
    border-top-right-radius: root.first ? 12px : 0px;
    border-bottom-left-radius: root.last ? 12px : 0px;
    border-bottom-right-radius: root.last ? 12px : 0px;

    if !root.first: Separator { }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            menu.show();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.fg.transparentize(root.fade);
                wrap: word-wrap;
            }
            if root.under != "": Text {
                text: root.under;
                color: Theme.ink(Theme.dim).transparentize(root.fade);
                font-size: Theme.footer;
                wrap: word-wrap;
            }
        }
        if !root.value-as-subtitle && root.known: Text {
            text: root.choices[root.selected];
            color: Theme.ink(Theme.dim).transparentize(root.fade);
            vertical-alignment: center;
            horizontal-alignment: right;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/pan-down-symbolic.svg");
                colorize: Theme.fg.transparentize(root.fade);
                width: 16px;
                height: 16px;
            }
        }
    }

    menu := PopupWindow {
        x: root.width - self.width - 6px;
        y: root.height - 4px;
        width: 240px;

        Rectangle {
            background: Theme.popover-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.card-outline;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 6px;
                for choice[index] in root.choices: Rectangle {
                    height: 34px;
                    border-radius: 6px;
                    background: item.has-hover ? Theme.ink(0.07) : transparent;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: choice;
                            color: Theme.fg;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("icons/object-select-symbolic.svg");
                                colorize: Theme.fg;
                                opacity: index == root.selected ? 1 : 0;
                                width: 16px;
                                height: 16px;
                            }
                        }
                    }

                    item := TouchArea {
                        clicked => {
                            if (index != root.selected) {
                                root.chosen(index);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Spin row: a whole number, typed or stepped, between two bounds.
export component SpinRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <bool> enabled: true;
    in property <bool> first: true;
    in property <bool> last: false;
    callback changed(int);

    property <float> fade: root.enabled ? 0 : 0.5;
    min-height: 50px;

    // Back to the value it was given when an edit is abandoned or refused.
    changed value => {
        field.text = root.value;
    }
    function commit() {
        if (!field.text.is-float()) {
            field.text = root.value;
            return;
        }
        root.step(round(field.text.to-float()) - root.value);
    }
    function step(by: int) {
        if (by == 0) {
            field.text = root.value;
            return;
        }
        root.changed(max(root.minimum, min(root.maximum, root.value + by)));
    }

    if !root.first: Separator { }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.fg.transparentize(root.fade);
                wrap: word-wrap;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.ink(Theme.dim).transparentize(root.fade);
                font-size: Theme.footer;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 52px;
                    height: 34px;
                    border-radius: 6px;
                    background: field.has-focus ? Theme.ink(0.1) : transparent;
                    field := TextInput {
                        width: parent.width - 8px;
                        text: root.value;
                        enabled: root.enabled;
                        color: Theme.fg.transparentize(root.fade);
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        single-line: true;
                        input-type: InputType.number;
                        selection-background-color: Theme.accent.with-alpha(0.3);
                        selection-foreground-color: Theme.fg;
                        accepted => {
                            root.commit();
                        }
                        changed has-focus => {
                            if (!self.has-focus) {
                                root.commit();
                            }
                        }
                    }
                }
                Button {
                    kind: 3;
                    circular: true;
                    has-icon: true;
                    icon: @image-url("icons/list-remove-symbolic.svg");
                    enabled: root.enabled && root.value > root.minimum;
                    clicked => {
                        root.step(-1);
                    }
                }
                Button {
                    kind: 3;
                    circular: true;
                    has-icon: true;
                    icon: @image-url("icons/list-add-symbolic.svg");
                    enabled: root.enabled && root.value < root.maximum;
                    clicked => {
                        root.step(1);
                    }
                }
            }
        }
    }
}

// Page switcher in a header bar: flat toggles, each an icon beside its page's name.
export component ViewSwitcher inherits HorizontalLayout {
    in property <[string]> labels;
    in property <[image]> icons;
    in property <int> active;
    callback chosen(int);
    spacing: 3px;

    for label[index] in root.labels: Rectangle {
        height: 34px;
        border-radius: 6px;
        background: index == root.active ? Theme.ink(touch.pressed ? 0.2 : 0.13) : touch.pressed ? Theme.ink(0.16) : touch.has-hover ? Theme.ink(0.07) : transparent;

        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icons[index];
                    colorize: Theme.fg;
                    width: 16px;
                    height: 16px;
                }
            }
            Text {
                text: label;
                color: Theme.fg;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        touch := TouchArea {
            clicked => {
                if (index != root.active) {
                    root.chosen(index);
                }
            }
        }
    }
}

// A group's heading and the sentence under it, both above the boxed list.
export component GroupHeading inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 2px;
    padding-bottom: 6px;
    padding-left: 2px;
    padding-right: 2px;
    if root.title != "": Text {
        text: root.title;
        color: Theme.fg;
        font-weight: 700;
    }
    if root.description != "": Text {
        text: root.description;
        color: Theme.ink(Theme.dim);
        font-size: Theme.footer;
        wrap: word-wrap;
    }
}

// A dim caption under a list.
export component Caption inherits Text {
    color: Theme.ink(Theme.dim);
    font-size: Theme.caption;
    wrap: word-wrap;
}

// Toast: one line on a dark pill near the bottom, for a few seconds.
export component Toast inherits Rectangle {
    in property <string> text;
    in property <int> serial;
    property <int> shown-serial: -1;
    property <bool> showing: root.serial == root.shown-serial && root.text != "";

    changed serial => {
        root.shown-serial = root.serial;
    }

    Timer {
        interval: 3500ms;
        running: root.showing;
        triggered => {
            root.shown-serial = -1;
        }
    }

    if root.showing: Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
        width: min(parent.width - 24px, label.preferred-width + 48px);
        height: max(42px, label.preferred-height + 20px);
        border-radius: 21px;
        background: #262626f0;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000040;

        label := Text {
            width: parent.width - 48px;
            text: root.text;
            color: #ffffff;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
    }
}

export struct MenuEntry {
    id: string,
    label: string,
    icon: image,
    has-icon: bool,
    // A separator above it: the start of a new section.
    section: bool,
    enabled: bool,
}

// A context menu opened at a point: drawn over the whole window, so a press anywhere
// outside it dismisses it and goes no further, as a popover's grab does. Arrow keys move
// the highlight, Return chooses and Escape dismisses.
export component ContextMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    // Where it was asked for, in window coordinates.
    in property <length> anchor-x;
    in property <length> anchor-y;
    in property <bool> align-right: false;
    callback chosen(string);
    callback dismissed();
    property <int> highlighted: -1;

    init => {
        keys.focus();
    }

    TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.dismissed();
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.dismissed();
            } else if (event.text == Key.DownArrow) {
                root.highlighted = mod(root.highlighted + 1, root.entries.length);
            } else if (event.text == Key.UpArrow) {
                root.highlighted = root.highlighted <= 0 ? root.entries.length - 1 : root.highlighted - 1;
            } else if (event.text == Key.Return || event.text == " ") {
                if (root.highlighted >= 0 && root.entries[root.highlighted].enabled) {
                    root.chosen(root.entries[root.highlighted].id);
                }
            } else if (event.text == Key.Tab || event.text == Key.Backtab) {
                // Keep focus here until selection or dismissal. Otherwise Slint's
                // default traversal reaches controls underneath the open menu.
                return accept;
            } else {
                return reject;
            }
            accept
        }
    }

    // Opens down and to the right of the point, and flips where the window has no room.
    popover := Rectangle {
        x: root.align-right || root.anchor-x + self.width > root.width - 6px ? max(6px, root.anchor-x - self.width) : root.anchor-x;
        y: root.anchor-y + self.height > root.height - 6px ? max(6px, root.anchor-y - self.height) : root.anchor-y;
        width: max(160px, column.preferred-width);
        height: column.preferred-height;
        background: Theme.popover-bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.card-outline;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000040;

        // Swallows presses on its own padding, which would otherwise dismiss it.
        TouchArea { }

        column := VerticalLayout {
            padding: 6px;
            for entry[index] in root.entries: VerticalLayout {
                if entry.section && index > 0: Rectangle {
                    height: 13px;
                    Rectangle {
                        height: 1px;
                        background: Theme.ink(0.1);
                    }
                }
                Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: index == root.highlighted && entry.enabled ? (item.pressed ? Theme.ink(0.16) : Theme.ink(0.07)) : transparent;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        if entry.has-icon: VerticalLayout {
                            alignment: center;
                            Image {
                                source: entry.icon;
                                colorize: Theme.fg.transparentize(entry.enabled ? 0 : 0.5);
                                width: 16px;
                                height: 16px;
                            }
                        }
                        Text {
                            text: entry.label;
                            color: Theme.fg.transparentize(entry.enabled ? 0 : 0.5);
                            vertical-alignment: center;
                        }
                    }

                    item := TouchArea {
                        changed has-hover => {
                            if (self.has-hover) {
                                root.highlighted = index;
                            } else if (root.highlighted == index) {
                                root.highlighted = -1;
                            }
                        }
                        clicked => {
                            if (entry.enabled) {
                                root.chosen(entry.id);
                            }
                        }
                    }
                }
            }
        }
    }
}
