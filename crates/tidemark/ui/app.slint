// The window: a header bar over either the card grid or a message page.

import { ScrollView, Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Card, CardData, GaugeData, RowData } from "card.slint";
import { ProviderDialog, ProviderSettings, ProviderRowData, PickerRowData, OptionData, SwitchData, CandidateData, DetailData } from "providers.slint";
import { Alert, AlertDialog, AlertForm, AlertResponse, PreviewRow } from "alert.slint";
import { Button, ContextMenu, MenuEntry } from "widgets.slint";
import { Prefs, PreferencesDialog } from "preferences.slint";
import { About, AboutDialog } from "about.slint";
import { NoteBlock, ReleaseNotes, ReleaseNotesDialog } from "release_notes.slint";
import { QuotaDetails, QuotaDetailsDialog, QuotaWindowData, QuotaDetailRow, QuotaSectionData } from "detail.slint";
import "../../../data/fonts/rubik/Rubik%5Bwght%5D.ttf";

export { Theme, CardData, GaugeData, RowData, ProviderSettings, ProviderRowData, PickerRowData, OptionData, SwitchData, CandidateData, DetailData, Alert, AlertForm, AlertResponse, PreviewRow, MenuEntry, Prefs, About, NoteBlock, ReleaseNotes, QuotaDetails, QuotaWindowData, QuotaDetailRow, QuotaSectionData }

component HeaderButton inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> spinning: false;
    callback clicked();
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background: !enabled ? transparent : touch.pressed ? Theme.ink(0.16) : touch.has-hover ? Theme.ink(0.07) : transparent;
    animate background { duration: 100ms; }

    // Faded through the colour: `opacity` on an item with children is drawn through an
    // off-grid texture, which blurs.
    Image {
        source: root.icon;
        colorize: Theme.fg.transparentize(root.enabled ? 0 : 0.5);
        width: 16px;
        height: 16px;
        transform-origin: { x: self.width / 2, y: self.height / 2 };
        transform-rotation: root.spinning ? mod(animation-tick() / 1ms, 800) / 800 * 360deg : 0deg;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// Window controls: a small round button with a faint fill, for windows that
// draw their own title bar.
component WindowButton inherits Rectangle {
    in property <image> icon;
    callback clicked();
    width: 24px;
    height: 24px;
    border-radius: self.height / 2;
    background: touch.pressed ? Theme.ink(0.3) : touch.has-hover ? Theme.ink(0.15) : Theme.ink(0.1);
    animate background { duration: 100ms; }

    Image {
        source: root.icon;
        colorize: Theme.fg;
        width: 16px;
        height: 16px;
    }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A status page: a large dim icon, a title, what to do about it, and a button doing it.
component StatusPage inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <string> action;
    callback acted();

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 24px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: Theme.ink(0.5);
                width: 128px;
                height: 128px;
            }
        }
        Text {
            text: root.title;
            color: Theme.fg;
            font-size: Theme.title-1;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: root.description;
            color: Theme.fg;
            font-size: Theme.body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.action != "": HorizontalLayout {
            alignment: center;
            padding-top: 6px;
            Button {
                text: root.action;
                kind: 1;
                has-icon: true;
                icon: @image-url("icons/list-add-symbolic.svg");
                clicked => {
                    root.acted();
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Tidemark";
    preferred-width: 1000px;
    preferred-height: 640px;
    min-width: 360px;
    min-height: 240px;
    // The compositor can only show the desktop through the rounded corners when the
    // window itself clears to transparent. The two backgrounds below paint its surface.
    background: transparent;
    default-font-family: "Rubik";
    default-font-size: Theme.body;

    // 0 waiting for the daemon, 1 connected with nothing to show, 2 the grid.
    in property <int> page: 0;
    in property <string> message: "";
    in property <bool> connected: false;
    // Some account is being polled: the refresh button turns until none is.
    in property <bool> refreshing: false;
    in property <string> available: "";
    in property <[CardData]> cards;
    // Zero means Auto: as many columns as fit.
    in property <int> max-columns: 0;
    in property <int> shown-count: 0;
    // The window draws its own title bar and frame: the header moves the window
    // and carries its controls, and Slint hands presses near the edges to the system's
    // resize. `maximized` and `minimized` are the window's own, kept in step with the
    // system, so a snap or a keyboard shortcut shows on the maximize button too.
    no-frame: true;
    resize-border-width: !self.maximized ? 6px : 0px;
    // Set by the platform: Windows 11 draws its own rounding at a smaller radius, and an
    // opaque surface cannot show through corners at all.
    in property <length> corner-radius: 12px;
    property <length> frame-radius: self.maximized || self.full-screen ? 0px : self.corner-radius;

    callback refresh();
    callback open-providers();
    callback close-window();
    callback open-release();
    callback toggle-group(int);
    // A completed drag, in visible slots; the window decides what it means. An extra
    // account moved among its provider's, from one slot to another:
    callback move-account(int, int);
    // a whole provider group, carried by the card from one slot and let go over another;
    // and, while it is in the air, the slot the group would start at.
    callback move-group(int, int);
    pure callback group-slot(int, int) -> int;
    // A card's secondary-click menu: which entries it offers is asked as it opens, and
    // what a chosen one does belongs to the window.
    callback card-menu(int) -> [MenuEntry];
    callback card-action(string);
    callback card-check-error(int);
    callback open-detail(int);
    callback open-preferences();
    callback open-about();

    property <[MenuEntry]> menu-entries;
    property <bool> menu-open: false;
    // Which menu is open: a card's, or the header's primary menu.
    property <bool> menu-primary: false;
    property <length> menu-x;
    property <length> menu-y;

    property <bool> dark: Theme.dark;
    changed dark => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Fixed card geometry, independent of provider state and content.
    property <length> cell-width: 300px;
    // Statuses, errors and account expansion never change the grid's geometry.
    property <length> cell-height: 234px;
    property <length> spacing: 12px;
    property <length> margin: 12px;
    property <length> available-width: scroller.visible-width - 2 * margin;
    property <int> fitting: max(1, floor((available-width + spacing) / (cell-width + spacing)));
    property <int> columns: max-columns > 0 ? min(fitting, max-columns) : fitting;
    property <int> rows: ceil(shown-count / columns);
    property <length> content-left: margin + max(0px, available-width - (columns * cell-width + (columns - 1) * spacing)) / 2;
    property <length> content-height: 2 * margin + rows * cell-height + max(0, rows - 1) * spacing;

    // The drag: which card (model index), from which slot, how far it has travelled, and
    // where it would land. Offsets are in content coordinates.
    property <int> drag-index: -1;
    property <int> drag-slot: -1;
    property <bool> carrying: false;
    property <length> drag-dx;
    property <length> drag-dy;
    property <int> drag-target: -1;
    // The carried card's group: its provider, the card's rank in it, and the slots it rests
    // in. Carried whole, the group rides in a stack under the card and `drag-target` is the
    // slot the group would start at, the one slot kept open for it until it is let go;
    // otherwise one extra account moves among its siblings.
    property <string> drag-group;
    property <int> drag-rank;
    property <int> drag-lead;
    property <int> drag-span: 1;
    property <bool> drag-whole: false;
    // The rest of the group flying in from their slots to the stack.
    property <bool> gathering: false;
    property <duration> gather-start;
    property <length> carry-x: whole-x(drag-slot) + drag-dx;
    property <length> carry-y: whole-y(drag-slot) + drag-dy;
    // Where the pointer is inside the visible part of the scroller, for autoscroll.
    property <length> pointer-y;
    // The card settling into its slot after a release, and where it was let go; with
    // `settle-group`, the stack it carried settling along with it.
    property <int> settle-index: -1;
    property <string> settle-group;
    property <length> settle-x;
    property <length> settle-y;
    property <duration> settle-start;

    pure function whole-x(index: int) -> length {
        return content-left + mod(index, columns) * (cell-width + spacing);
    }
    pure function whole-y(index: int) -> length {
        return margin + floor(index / columns) * (cell-height + spacing);
    }
    // A fractional slot interpolates between the whole slots either side of it, including
    // the step from the end of one row to the start of the next.
    pure function slot-x(position: float) -> length {
        return whole-x(floor(position)) + (position - floor(position)) * (whole-x(floor(position) + 1) - whole-x(floor(position)));
    }
    pure function slot-y(position: float) -> length {
        return whole-y(floor(position)) + (position - floor(position)) * (whole-y(floor(position) + 1) - whole-y(floor(position)));
    }
    // Where the other cards go while the carried card, or its whole group, is on its way
    // to `drag-target`: they close up over the slots it rested in and leave one open at
    // the target, so a large group does not push the rest of the grid away in mid-air.
    pure function shifted(slot: int) -> int {
        let from = drag-whole ? drag-lead : drag-slot;
        let span = drag-whole ? drag-span : 1;
        if (!carrying || (slot >= from && slot < from + span)) {
            return slot;
        }
        let closed = slot < from ? slot : slot - span;
        return closed < drag-target ? closed : closed + 1;
    }
    // The slot under the carried card's centre, measured against the resting slots so it
    // cannot flicker while the pointer holds still.
    pure function hovered-slot() -> int {
        if (shown-count == 0) {
            return 0;
        }
        return min(shown-count - 1, clamp(floor((carry-y + cell-height / 2 - margin) / (cell-height + spacing)), 0, rows - 1) * columns + clamp(floor((carry-x + cell-width / 2 - content-left) / (cell-width + spacing)), 0, columns - 1));
    }
    // Points the drag at where it would land. An extra account moves among its siblings,
    // after their provider's card; carried out of its group, it takes the group along.
    function aim() {
        let hovered = hovered-slot();
        if (!drag-whole && (hovered < drag-lead || hovered >= drag-lead + drag-span)) {
            gather();
        }
        drag-target = drag-whole ? root.group-slot(drag-slot, hovered) : clamp(hovered, drag-lead + 1, drag-lead + drag-span - 1);
    }
    function gather() {
        drag-whole = true;
        gathering = true;
        gather-start = animation-tick();
    }
    pure function gather-progress() -> float {
        return gathering ? 1 - pow(1 - clamp((animation-tick() - gather-start) / 250ms, 0, 1), 3) : 1;
    }
    pure function settle-progress() -> float {
        return 1 - pow(1 - clamp((animation-tick() - settle-start) / 200ms, 0, 1), 3);
    }
    // The stack a group is carried in: each card behind the carried one a little lower and
    // turned, the second the other way; any further hide behind the second.
    pure function stack-x(depth: int) -> length {
        return min(depth, 2) * 5px;
    }
    pure function stack-y(depth: int) -> length {
        return min(depth, 2) * 4px;
    }
    pure function stack-angle(depth: int) -> angle {
        return depth == 0 ? 0deg : depth == 1 ? 4deg : -3deg;
    }
    // Pixels per second: nothing until the pointer is within 48px of an edge.
    pure function autoscroll-rate() -> float {
        if (scroller.visible-height <= 96px) {
            return 0;
        }
        if (pointer-y < 48px) {
            return -900 * (1 - max(0, pointer-y / 48px));
        }
        if (scroller.visible-height - pointer-y < 48px) {
            return 900 * (1 - max(0, (scroller.visible-height - pointer-y) / 48px));
        }
        return 0;
    }

    function release() {
        if (carrying) {
            settle-x = carry-x;
            settle-y = carry-y;
            settle-start = animation-tick();
            settle-index = drag-index;
            settle-group = drag-whole ? drag-group : "";
            carrying = false;
            drag-index = -1;
            if (drag-whole) {
                root.move-group(drag-slot, hovered-slot());
            } else {
                root.move-account(drag-slot, drag-target);
            }
        } else {
            drag-index = -1;
        }
    }

    Timer {
        interval: 200ms;
        running: root.settle-index >= 0;
        triggered => {
            root.settle-index = -1;
            root.settle-group = "";
        }
    }

    Timer {
        interval: 250ms;
        running: root.gathering;
        triggered => {
            root.gathering = false;
        }
    }

    Timer {
        interval: 16ms;
        running: root.carrying && root.autoscroll-rate() != 0;
        triggered => {
            let before = scroller.content-y;
            scroller.content-y = clamp(scroller.content-y - root.autoscroll-rate() * 16px / 1000, min(0px, scroller.visible-height - scroller.content-height), 0px);
            root.drag-dy += before - scroller.content-y;
            root.aim();
        }
    }

    VerticalLayout {
        // A header bar drawn by the window itself.
        Rectangle {
            height: 47px;
            // Rotated cards' nested clips are approximate; keep the header above the grid.
            z: 1;
            background: Theme.header-bg;
            border-top-left-radius: root.frame-radius;
            border-top-right-radius: root.frame-radius;
            // Paint the rounded background without clipping its children: a rounded
            // clip would put all the header text into FemtoVG's off-grid texture.

            // The built-in move area cancels Slint's pointer grab before handing a
            // drag to the compositor, which may consume the matching release.
            WindowMoveArea {
                TouchArea {
                    double-clicked => {
                        root.maximized = !root.maximized;
                    }
                }
            }

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: space-between;
                VerticalLayout {
                    alignment: center;
                    HeaderButton {
                        icon: @image-url("icons/dialog-password-symbolic.svg");
                        enabled: root.connected;
                        clicked => {
                            root.open-providers();
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    if root.available != "": VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            icon: @image-url("icons/software-update-available-symbolic.svg");
                            clicked => {
                                root.open-release();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HeaderButton {
                            icon: @image-url("icons/view-refresh-symbolic.svg");
                            enabled: root.connected;
                            spinning: root.refreshing && root.connected;
                            clicked => {
                                root.refresh();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        // The platform's primary menu: rightmost, where a GNOME user looks for
                        // About without being told where it is.
                        primary := HeaderButton {
                            icon: @image-url("icons/open-menu-symbolic.svg");
                            clicked => {
                                root.menu-entries = [
                                    { id: "preferences", label: "Preferences", enabled: root.connected },
                                    { id: "about", label: "About Tidemark", section: true, enabled: true },
                                ];
                                root.menu-primary = true;
                                root.menu-x = self.absolute-position.x + self.width;
                                root.menu-y = self.absolute-position.y + self.height + 4px;
                                root.menu-open = true;
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 4px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            WindowButton {
                                icon: @image-url("icons/window-minimize-symbolic.svg");
                                clicked => {
                                    root.minimized = true;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            WindowButton {
                                icon: root.maximized ? @image-url("icons/window-restore-symbolic.svg") : @image-url("icons/window-maximize-symbolic.svg");
                                clicked => {
                                    root.maximized = !root.maximized;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            WindowButton {
                                icon: @image-url("icons/window-close-symbolic.svg");
                                clicked => {
                                    root.close-window();
                                }
                            }
                        }
                    }
                }
            }

            Text {
                text: "Tidemark";
                color: Theme.fg;
                font-size: Theme.body;
                font-weight: 700;
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.header-shade;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.window-bg;
            border-bottom-left-radius: root.frame-radius;
            border-bottom-right-radius: root.frame-radius;

            if root.page == 0: StatusPage {
                icon: @image-url("icons/network-offline-symbolic.svg");
                title: "Waiting for Tidemark";
                description: root.message;
            }

            if root.page == 1: StatusPage {
                icon: @image-url("icons/view-grid-symbolic.svg");
                title: "Welcome to Tidemark";
                description: "Add a provider to start tracking your quota.";
                action: "Add provider";
                // Straight to the catalog: the dialog's list would only be empty.
                acted => {
                    root.open-providers();
                    ProviderSettings.add();
                }
            }

            scroller := ScrollView {
                visible: root.page == 2;
                // Keep the scrollbars and dragged cards above the transparent corners.
                height: parent.height - root.frame-radius;
                content-width: self.visible-width;
                content-height: root.content-height;

                for card[index] in root.cards: slot := Rectangle {
                    property <bool> carried: root.carrying && root.drag-index == index;
                    // Another account of a group carried whole: it rides in the stack.
                    property <bool> stacked: root.carrying && root.drag-whole && card.provider == root.drag-group && !carried;
                    // On the carried card while it carries a group: how many are in the stack.
                    property <bool> counting: carried && root.drag-whole && card.members > 1;
                    // Its place in the stack: the carried card on top, the rest behind it in
                    // account order.
                    property <int> depth: card.rank == root.drag-rank ? 0 : card.rank < root.drag-rank ? card.rank + 1 : card.rank;
                    // Pressed with a drag possible: raised at once, before the pointer has
                    // travelled far enough to start carrying it.
                    property <bool> grabbed: root.drag-index == index;
                    property <bool> settling: root.settle-index == index || (root.settle-group != "" && card.provider == root.settle-group);
                    // Retained through release(): clearing the global drag must not turn
                    // its final pointer release into a card click.
                    property <bool> was-dragged: false;
                    // The slot in index units, so a window resize repositions instantly
                    // while a reorder animates.
                    property <float> position: root.shifted(card.slot);
                    animate position {
                        duration: slot.settling ? 0ms : 250ms;
                        easing: cubic-bezier(0.33, 1, 0.68, 1);
                    }

                    // A stacked card flies from its slot to its place behind the carried
                    // one; a settling one from where it was let go to its slot.
                    x: carried ? root.carry-x
                        : stacked ? root.slot-x(position) + root.gather-progress() * (root.carry-x + root.stack-x(depth) - root.slot-x(position))
                        : settling ? root.settle-x + root.stack-x(depth) + root.settle-progress() * (root.whole-x(card.slot) - root.settle-x - root.stack-x(depth))
                        : root.slot-x(position);
                    y: carried ? root.carry-y
                        : stacked ? root.slot-y(position) + root.gather-progress() * (root.carry-y + root.stack-y(depth) - root.slot-y(position))
                        : settling ? root.settle-y + root.stack-y(depth) + root.settle-progress() * (root.whole-y(card.slot) - root.settle-y - root.stack-y(depth))
                        : root.slot-y(position);
                    transform-rotation: stacked ? root.gather-progress() * root.stack-angle(depth)
                        : settling ? (1 - root.settle-progress()) * root.stack-angle(depth)
                        : 0deg;
                    width: root.cell-width;
                    height: root.cell-height;
                    z: grabbed || stacked || settling ? 10 - depth : card.main ? 1 : 0;
                    // A collapsed group's hidden accounts show only while in the stack.
                    opacity: card.shown || stacked ? 1 : 0;
                    animate opacity { duration: 180ms; easing: cubic-bezier(0.33, 1, 0.68, 1); }

                    touch := TouchArea {
                        enabled: card.shown;
                        mouse-cursor: slot.grabbed ? MouseCursor.grabbing : MouseCursor.default;

                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                slot.was-dragged = false;
                            }
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down && root.shown-count > 1) {
                                root.drag-index = index;
                                root.drag-slot = card.slot;
                                root.drag-target = card.slot;
                                root.drag-group = card.provider;
                                root.drag-rank = card.rank;
                                // A group's shown accounts follow its provider's card.
                                root.drag-lead = card.slot - card.rank;
                                root.drag-span = card.expanded ? card.members : 1;
                                // The provider's own card always carries the whole group.
                                root.drag-whole = card.main;
                                root.drag-dx = 0;
                                root.drag-dy = 0;
                            }
                            if (event.button == PointerEventButton.left && (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel)) {
                                root.release();
                            }
                            // On press, not release: that is when every other menu on the
                            // desktop appears.
                            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down && root.drag-index < 0) {
                                root.menu-entries = root.card-menu(index);
                                root.menu-primary = false;
                                if (root.menu-entries.length > 0) {
                                    root.menu-x = self.absolute-position.x + self.mouse-x;
                                    root.menu-y = self.absolute-position.y + self.mouse-y;
                                    root.menu-open = true;
                                }
                            }
                        }

                        clicked => {
                            if (!slot.was-dragged) {
                                root.open-detail(index);
                            }
                        }

                        moved => {
                            if (root.drag-index != index) {
                                return;
                            }
                            if (!root.carrying) {
                                // A click that wobbles within the drag threshold is still a click.
                                if (abs(self.mouse-x - self.pressed-x) < 8px && abs(self.mouse-y - self.pressed-y) < 8px) {
                                    return;
                                }
                                root.carrying = true;
                                slot.was-dragged = true;
                                if (root.drag-whole) {
                                    root.gather();
                                }
                            }
                            // The slot moves with the pointer, so what the pointer has moved
                            // since the last event is its distance from the grip point.
                            root.drag-dx += self.mouse-x - self.pressed-x;
                            root.drag-dy += self.mouse-y - self.pressed-y;
                            root.pointer-y = slot.y + self.mouse-y + scroller.content-y;
                            root.aim();
                        }
                    }

                    body := Card {
                        y: touch.has-hover && !root.carrying && root.settle-index < 0 ? -2px : 0px;
                        animate y { duration: 150ms; easing: ease-out; }
                        width: parent.width;
                        height: parent.height;
                        data: card;
                        lifted: slot.stacked || (touch.has-hover && !root.carrying);
                        carried: slot.grabbed;
                        interactive: card.shown && !root.menu-open && !Alert.open && !Prefs.open && !About.open
                            && !ReleaseNotes.open && !ProviderSettings.open && !QuotaDetails.open;
                        check-error => { root.card-check-error(index); }
                    }

                    // A notification-style counter on the provider's card, outside the title
                    // row so that nothing in the row can push it around. A stack wears the
                    // badge of a collapsed group, popping up on a card that had none, and
                    // cards inside it wear none, where it would peek out beside that one.
                    if slot.counting || (card.badge != "" && !slot.stacked): Rectangle {
                        x: parent.width - 18px;
                        y: body.y - 10px;
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.accent;
                        border-width: card.expanded && !slot.counting ? 2px : 0px;
                        border-color: Theme.accent-fg.with-alpha(0.45);
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        drop-shadow-color: #0000004d;
                        transform-scale: slot.counting && card.badge == "" ? 0.6 + 0.4 * root.gather-progress() : 1;

                        Text {
                            text: slot.counting ? "+\{card.members - 1}" : card.badge;
                            color: Theme.accent-fg;
                            font-size: Theme.body * 0.75;
                            font-weight: 700;
                        }

                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => {
                                root.toggle-group(index);
                            }
                        }
                    }
                }
            }
        }
    }

    if root.menu-open: ContextMenu {
        width: root.width;
        height: root.height;
        entries: root.menu-entries;
        anchor-x: root.menu-x;
        anchor-y: root.menu-y;
        chosen(id) => {
            root.menu-open = false;
            if (!root.menu-primary) {
                root.card-action(id);
            } else if (id == "preferences") {
                root.open-preferences();
            } else {
                root.open-about();
            }
        }
        dismissed => {
            root.menu-open = false;
        }
    }

    if QuotaDetails.open: QuotaDetailsDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }

    if Prefs.open: PreferencesDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }

    if About.open: AboutDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }

    if ReleaseNotes.open: ReleaseNotesDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }

    if ProviderSettings.open: ProviderDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }

    if Alert.open: AlertDialog {
        width: root.width;
        height: root.height;
        border-radius: root.frame-radius;
    }
}
