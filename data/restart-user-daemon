#!/bin/sh
set -eu

# Package transactions run as root, so an unqualified `systemctl --user` would talk to
# root's manager rather than to the logged-in desktop users. The `.host` transport reaches
# each user's real manager through PID 1. `try-restart` leaves an inactive daemon inactive;
# D-Bus activation will start it when Tidemark is next opened.
loginctl_command=${TIDEMARK_LOGINCTL:-/usr/bin/loginctl}
systemctl_command=${TIDEMARK_SYSTEMCTL:-/usr/bin/systemctl}

"$loginctl_command" list-users --no-legend --no-pager | while read -r _uid user _linger _state; do
    [ -n "$user" ] || continue
    "$systemctl_command" --user --machine="${user}@.host" daemon-reload || true
    "$systemctl_command" --user --machine="${user}@.host" try-restart tidemarkd.service || true
done
