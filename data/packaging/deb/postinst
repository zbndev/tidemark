#!/bin/sh
set -e

# dpkg runs this after the new files are unpacked, which is the point at which restarting
# the daemon picks up the new binary rather than the old one.
#
# $1 is the action, $2 the previously configured version. A non-empty $2 means this is an
# upgrade; empty means a fresh install, which has no running daemon to replace.
if [ "$1" = configure ]; then
    if [ -n "$2" ]; then
        /usr/lib/tidemark/restart-user-daemon
    else
        # Never allowed to fail the transaction. The notice lives under /usr/lib rather
        # than /usr/share/doc because a minimal installation excludes documentation —
        # Ubuntu's own container image ships path-exclude=/usr/share/doc/*, and reading a
        # greeting from there aborted the install outright.
        cat /usr/lib/tidemark/first-run.txt 2>/dev/null || true
    fi
fi

#DEBHELPER#
